#!/usr/bin/env python3

import argparse
import subprocess
from pathlib import Path
from serial import Serial

def write(data, serial):
    serial.write(data)

#18bit words transmitted using 4 bytes with format:
#     upper2 middle8 lower8 wordcode
#
# wordcodes:
#  0: receive 18 bit word
#  1: exit
def listen(port, speed, serial, verbose=True):
    if verbose:
        print("Listening. port={}, speed={}".format(port, speed))

    def read_n( n ):
        x = list(serial.read(n))
        x.reverse()
        word = 0
        for byte in x:
            word = ( word << 8 ) | byte
            n -= 1
        return word

    while True:
        n = read_n( 1 )
        if n  == 1:
            print("[exit]")
            return
        if n == 0:
            n = read_n( 3 )
            print(n & 0x3ffff)
        else:
            print("ERROR -- unknown code:", n)

def make_bootstream(filename, bootstream_type):
    result = subprocess.run(
        [str(Path(__file__).resolve().with_name("ga")),
         "--bootstream-type", bootstream_type, "--only-bootstream", filename],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    )
    return bytes(int(value) for value in result.stdout.split())

default_speed = 460800
bootstream_types = [ "async", "2wire", "async-target" ]
bootstream_type = "async"

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Compile, load, and optionally listen to a GA144 bootstream."
    )
    parser.add_argument("filename", help="aForth source file")
    parser.add_argument("port", help="serial device, for example /dev/ttyUSB0")
    parser.add_argument("--speed", "-s", type=int, default=default_speed)
    parser.add_argument("--bootstream", "-b", choices=bootstream_types,
                        default=bootstream_type)
    parser.add_argument("--no-listen", action="store_true",
                        help="return after transmitting the bootstream")
    args = parser.parse_args()

    bootstream = make_bootstream(args.filename, args.bootstream)
    with Serial(args.port, args.speed) as host:
        write(bootstream, host)
        if not args.no_listen:
            listen(args.port, args.speed, host)


